# Cloudflare Pages: the service worker, HTML shell and manifest must always be revalidated so a new deploy is detected.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/diag.html
  Cache-Control: no-cache
# Hashed build output never changes, so it can be cached forever (and is also precached by the service worker).
/assets/*
  Cache-Control: public, max-age=31536000, immutable
